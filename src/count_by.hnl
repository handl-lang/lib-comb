--- Counts the elements of a list grouped by a key function.
---
--- @details
--- `count_by` takes `[key_fn, xs]` and returns an object mapping each
--- distinct `key_fn(x)` (stringified) to the number of elements that
--- produced it. Keys are sorted. It is the `comb`-surface spelling of
--- `combinators.count_by`.
---
--- @example
--- `[x ~> x % 2, [1, 2, 3, 4, 5]] >>> comb.count_by`
--- -- => { "0": 2, "1": 3 }
---
export count_by := [key_fn, xs] ~> combinators.count_by(key_fn, xs)
