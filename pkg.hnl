-- lib-comb: package manifest.
-- `modules` declares only the `combinators` atom surface; the other
-- src/*.hnl files are the `comb.*` pure-handl payload vendored for
-- kit-prelude's CombModule (one HandlModule per file, not a pkg module).
{
  modules: ["combinators"],
  entry: "src/combinators.hnl",
  name: "comb",
  description: "Combinator library — pure handl (comb plus combinators).",
  license: "MIT",
  keywords: ["combinators", "functional", "stdlib", "handl"],
  homepage: "https://github.com/handl-lang/lib-comb",
}
